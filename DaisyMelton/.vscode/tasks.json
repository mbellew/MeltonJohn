{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: Compile DaisyMelton",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "STMicroelectronics:stm32:GenH7:pnum=DAISY_SEED,usb=CDCgen",
        "--libraries",
        "${env:HOME}/Documents/Arduino/libraries",
        "--output-dir",
        "${workspaceFolder}/build",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload DaisyMelton (DFU)",
      "type": "shell",
      "command": "dfu-util -d 0483:df11 -a 0 -s 0x08000000:leave -D \"${workspaceFolder}/build/DaisyMelton.ino.bin\" || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": []
}
