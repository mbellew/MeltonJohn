{
    "configurations": [
        {
            "name": "DaisyMelton (Daisy Seed / STM32H7)",
            "includePath": [
                "${workspaceFolder}",
                "${env:HOME}/Library/Arduino15/packages/STMicroelectronics/hardware/stm32/2.12.0/cores/arduino",
                "${env:HOME}/Library/Arduino15/packages/STMicroelectronics/hardware/stm32/2.12.0/system/Drivers/CMSIS/Include",
                "${env:HOME}/Documents/Arduino/libraries/DaisyDuino/src",
                "${env:HOME}/Documents/Arduino/libraries/U8g2/src"
            ],
            "defines": [
                "ARDUINO=10819",
                "STM32H750xx",
                "ARDUINO_DAISY_SEED",
                "USBCON",
                "USBD_USE_CDC"
            ],
            "compilerPath": "${env:HOME}/Library/Arduino15/packages/STMicroelectronics/tools/xpack-arm-none-eabi-gcc/14.2.1-1.1/bin/arm-none-eabi-g++",
            "cStandard": "gnu11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "gcc-arm"
        }
    ],
    "version": 4
}
